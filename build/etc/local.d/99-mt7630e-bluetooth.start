#!/bin/sh

attiva_bluetooth() {
    # 1. Attesa di sicurezza per il boot o il risveglio completo
    sleep 4

    # 2. Carichiamo btusb da zero
    /sbin/modprobe -r btusb
    sleep 1
    /sbin/modprobe btusb
    sleep 1

    # 3. Iniettiamo l'ID Foxconn
    if [ -e "/sys/bus/usb/drivers/btusb/new_id" ]; then
        echo "0489 e080" > /sys/bus/usb/drivers/btusb/new_id
    fi
    sleep 1

    # 4. Il Fix di Neurobin: Rimuoviamo il blocco ACPI ed forziamo l'interfaccia UP
    /usr/sbin/rfkill unblock bluetooth
    /etc/init.d/bluetooth restart
}

# Lanciamo la funzione in background per non bloccare Niri o OpenRC
attiva_bluetooth &
