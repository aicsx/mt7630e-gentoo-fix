# MT7630E Gentoo Fix
# Esempio generato per il dispositivo USB rilevato: 0489:e080.
# L'installer usa il template .in e rileva automaticamente gli ID.

SUBSYSTEM=="usb", ATTR{idVendor}=="0489", ATTR{idProduct}=="e080", RUN+="/bin/sh -c 'sleep 1 && echo 0489 e080 > /sys/bus/usb/drivers/btusb/new_id'"
